# Jev backend expansion PLAN — new controls are NOT implemented yet.
# Target: omsenjalia/weathergpt/backend/.env or backend secret/environment store.
# Merge deliberately; never overwrite existing secrets or copy into Flutter.
# No real credentials. Leave expanded features off until tested and authorized.

# Existing backend settings (shown as comments to avoid changing current config).
# TYPESAFE_API_KEY=your_typesafe_api_key_here
# TYPESAFE_ENABLED=1
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# TYPESAFE_CHAT_ROUTING=1
# TYPESAFE_REPLY_CHECK=0
# TYPESAFE_TIMEOUT_SECONDS=4
# TYPESAFE_MAX_ATTEMPTS=3
# TYPESAFE_RETRY_BACKOFF_SECONDS=0.4
# Existing confidence defaults are not proof of calibration for new tasks.
# TYPESAFE_INTENT_MIN_CONFIDENCE=0.55
# TYPESAFE_ADVISORY_MIN_CONFIDENCE=0.55

# PLANNED global gate for new WeatherNext-informed Jev features.
# off = existing Jev behaviour unchanged (deterministic bug fixes independent).
# shadow = call/evaluate privately; no user-visible decision changes, still costs.
# enforce = only individually reviewed, authorized, allowlisted features apply.
# TYPESAFE_ENABLED=0 remains the master switch for ALL Jev calls.
TYPESAFE_WEATHERNEXT_MODE=off

# PLANNED allowlist: exact registry IDs, empty = no expanded features selected.
# Example after review: route.intent,quality.semantic_support,farm.spray_windows
TYPESAFE_DECISION_FEATURES=

# PLANNED bounded execution. Illustrative starting values, not vendor limits or
# measured production targets. Total request budget includes attempts/backoff.
TYPESAFE_TOTAL_BUDGET_MS=4000
TYPESAFE_MAX_CALLS_PER_REQUEST=2
TYPESAFE_MAX_QUESTIONS_PER_CALL=24
# Reserve room below the current client's 8000-character state slice.
# Structured serializer must preserve complete safety/date/evidence context.
TYPESAFE_MAX_STATE_CHARS=7000

# PLANNED privacy-first diagnostics; audit records need a secure backend store.
# Raw prompt/model payload logging must stay disabled in production.
TYPESAFE_DECISION_AUDIT_ENABLED=1
TYPESAFE_DECISION_AUDIT_RETENTION_DAYS=7
TYPESAFE_DECISION_LOG_RAW_PAYLOADS=0

# Per-feature confidence thresholds, criteria, timeout/cost classes and model/
# rule/template versions belong to reviewed registry policy, not arbitrary
# client request fields. Unreviewed or data-sharing-blocked features stay off.
# Caching and expiry must also obey evidence freshness and data retention rights.
