# PLANNED WeatherNext configuration; NOT wired into the current backend.
# Merge into omsenjalia/weathergpt/backend/.env after adapter implementation.
# Do not replace existing backend settings. Never put this in Flutter's .env.
# All WEATHER* settings and GOOGLE_OAUTH_* names below are proposed app settings.
# No real credentials are included. Keep enabled=0 until setup/access checks pass.

WEATHERNEXT_ENABLED=0
WEATHERNEXT_AUTH_MODE=adc
WEATHERNEXT_SURFACE=bigquery
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_QUOTA_PROJECT=your-billing-project-id

# BigQuery surface statistics. WeatherNext 2 and WeatherNext 3 are separate
# Analytics Hub listings, so each is linked into its OWN dataset in your
# project - they can never share one dataset. A linked dataset can be renamed;
# set the dataset names and let the table names default to the published ones.
WEATHERNEXT_BQ_LOCATION=US
WEATHERNEXT_BQ_DATASET_3=weathernext
WEATHERNEXT_BQ_DATASET_2=weathernext_2
WEATHERNEXT_BQ_SURFACE_TABLE=your-project-id.weathernext.weathernext_3_0_0_0p1deg
WEATHERNEXT_BQ_STATION_TABLE=your-project-id.weathernext.weathernext_3_0_0_0p05deg
# WN2 / WN2 Mean tables (composed defaults shown; WN2 Mean is its own table).
# WEATHERNEXT_TABLE_2=your-project-id.weathernext_2.weathernext_2_0_0
# WEATHERNEXT_TABLE_2_MEAN=your-project-id.weathernext_2.weathernext_2_0_0_mean
# A WN2 table inside the WN3 dataset fails validation on purpose; only set this
# if the project really links both listings into one dataset.
# WEATHERNEXT_BQ_ALLOW_SHARED_DATASET=0
# Repair a stale table id (renamed linked dataset) with one metadata-only
# list_tables call. No bytes billed.
# WEATHERNEXT_BQ_TABLE_DISCOVERY=1
# Illustrative per-query cap, NOT a total cloud spending cap. Tune using dry runs.
WEATHERNEXT_BQ_MAX_BYTES_BILLED=100000000

# GCS. Pass the Requester Pays project explicitly in the storage adapter.
WEATHERNEXT_GCS_ENSEMBLE_ROOT=gs://weathernext3_spatial/weathernext_3_0_0/zarr/
WEATHERNEXT_GCS_STATISTICS_ROOT=gs://weathernext3_statistics_spatial/weathernext_3_0_0_statistics/zarr/
WEATHERNEXT_GCS_USER_PROJECT=your-billing-project-id

# Optional Earth Engine capability: also needs project registration/API/IAM.
# WEATHERNEXT_EE_PROJECT=your-earth-engine-project-id

# ADC mode (recommended): use local gcloud ADC, an attached service account,
# or an approved workload identity. Leave this UNSET for local gcloud ADC or
# attached identity. If a file is needed, set a trusted, mounted absolute PATH,
# not JSON contents. Prefer federation; service-account keys are a last resort.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-credentials.json

# Alternative owner-authorized OAuth mode (planned): change AUTH_MODE to oauth.
# Client ID + secret alone are NOT enough: obtain a matching refresh token via
# a one-time consent flow by the Google account approved for WeatherNext.
# Store these in backend secrets/environment only; never log or send to clients.
# GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# Bootstrap only: must exactly match an authorized redirect URI for the client.
# GOOGLE_OAUTH_REDIRECT_URI=https://your-backend.example.com/admin/google/callback
# The callback/bootstrap helper does not exist yet. No client_credentials grant.

# Planned fixed automatic selection order; OAuth client identity is NOT IMD auth.
WEATHER_PROVIDER_PRIORITY=imd,weathernext,accuweather,open_meteo
# Existing provider settings, if needed (retain any real values in your backend):
# IMD_API_KEY=
# IMD_JWT_TOKEN=
# ACCUWEATHER_KEY=

# Optional PLANNED rollout of WeatherNext-enriched Jev decision inputs.
# off leaves existing Jev behaviour unchanged; shadow records comparisons only.
# Enforce requires validated features, permission to send data, and evaluation.
# Existing TYPESAFE_API_KEY/TYPESAFE_MODEL still configure Jev separately.
# TYPESAFE_WEATHERNEXT_MODE=off
