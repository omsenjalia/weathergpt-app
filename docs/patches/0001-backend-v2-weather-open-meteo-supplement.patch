+    current = hourly[0]
+    daily = [
+        {"date": "2026-09-19", "high_c": 31.1, "low_c": 24.9, "condition": None, "sunrise": None, "sunset": None},
+        {"date": "2026-09-20", "high_c": 30.9, "low_c": 24.3, "condition": "Slight rain", "sunrise": None, "sunset": None},
