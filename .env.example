# WeatherGPT Mobile (React Native / Expo port)
# The app renders and requests; the backend owns provider selection, keys and
# authorization. This is the only configuration value the app needs.

# Backend base URL. Defaults to the production FastAPI deployment when unset.
# Local dev examples:
#   web preview:      http://localhost:8888
#   android emulator: http://10.0.2.2:8888
EXPO_PUBLIC_BACKEND_URL=https://weathergpt-backend.vercel.app

# Shared secret the backend requires (its BACKEND_SECRET), sent as X-Backend-Secret.
# Must match the server exactly or every request is refused; leave empty when the
# backend has no BACKEND_SECRET (local development). CI fills it from the
# BACKEND_SECRET repository secret. Never commit a real value.
EXPO_PUBLIC_BACKEND_SECRET=
